diff --git a/Firmware/MotorControl/axis.cpp b/Firmware/MotorControl/axis.cpp
index 03735ce..c799964 100644
--- a/Firmware/MotorControl/axis.cpp
+++ b/Firmware/MotorControl/axis.cpp
@@ -208,6 +208,21 @@ bool Axis::run_lockin_spin(const LockinConfig_t &lockin_config, bool remain_arme
         motor_.phase_vel_src_.connect_to(&open_loop_controller_.phase_vel_);
         motor_.current_control_.phase_vel_src_.connect_to(&open_loop_controller_.phase_vel_);
         acim_estimator_.rotor_phase_vel_src_.connect_to(&open_loop_controller_.phase_vel_);
+
+        // PATCH (CAN/telemetry passthrough for LOCKIN_SPIN): Axis::start_closed_loop_control()
+        // is the only place that normally wires controller_.pos_estimate_linear_src_ /
+        // vel_estimate_src_ to the encoder -- CANSimple::get_encoder_estimates_callback()
+        // (the periodic ENCODER_ESTIMATES broadcast) reads from those same ports, not
+        // directly from encoder_.pos_estimate_/vel_estimate_. Since LOCKIN_SPIN never runs
+        // start_closed_loop_control(), those ports were left disconnected and the CAN
+        // telemetry would report 0.0 even though encoder_.pos_estimate_/vel_estimate_
+        // update continuously and meaningfully on their own (confirmed: they are gated by
+        // hall_polarity_calibrated, not by the encoder's is_ready/offset-calibration flag).
+        // Wiring them here is pure data routing for telemetry -- it does not affect
+        // control, so it's harmless for the other run_lockin_spin() callers (motor/encoder
+        // calibration, sensorless ramp) too.
+        controller_.pos_estimate_linear_src_.connect_to(&encoder_.pos_estimate_);
+        controller_.vel_estimate_src_.connect_to(&encoder_.vel_estimate_);
     }
     wait_for_control_iteration();
 
@@ -217,7 +232,52 @@ bool Axis::run_lockin_spin(const LockinConfig_t &lockin_config, bool remain_arme
     bool success = false;
     float dir = lockin_config.vel >= 0.0f ? 1.0f : -1.0f;
 
+    // PATCH (velocity PI): integrator state for the optional PI loop below.
+    // Local (not a class member) so it naturally resets to 0 every time
+    // run_lockin_spin() is (re-)entered -- same reset-on-entry semantics as
+    // phase_vel_/open_loop_controller_ state above, no separate reset code needed.
+    float vel_pi_integrator = 0.0f;
+    const float vel_pi_dt = 0.001f;  // matches this loop's ~1kHz osDelay(1) cadence
+
     while ((requested_state_ == AXIS_STATE_UNDEFINED) && motor_.is_armed_) {
+        // PATCH (reactive open-loop): continuously feed the live lockin config into
+        // the open-loop controller so writes to general_lockin.vel/current/accel take
+        // effect WITHOUT re-entering the state. phase_vel_ then ramps smoothly from the
+        // current speed to the new target at general_lockin.accel (no restart from 0,
+        // no re-arm). Harmless for the calibration/sensorless callers (their config is
+        // static, so this just re-writes the same values each iteration).
+        float commanded_vel = lockin_config.vel;
+
+        // PATCH (velocity PI, opt-in via lockin_config.vel_pi_enable): when disabled
+        // (default), behavior above/below is unchanged pure open-loop. When enabled,
+        // treat `vel` as the setpoint and trim it using the encoder as a plain
+        // tachometer (encoder_.vel_estimate_ is confirmed to update continuously and
+        // meaningfully here even without a commutation-grade encoder -- see the
+        // CAN-telemetry patch above; same reasoning applies). This corrects for
+        // slip/friction/load while commutation itself stays fully open-loop/forced --
+        // it only ever adjusts the *target field speed*, never touches phase alignment,
+        // so it cannot destabilize FOC the way feeding this into a true closed loop
+        // would. encoder_.vel_estimate_ is in encoder "turns"/s (per its cpr); converted
+        // to electrical rad/s with the same *2*pi*pole_pairs factor used everywhere else
+        // in this file (e.g. the CAN SET_INPUT_VEL handler) so the error stays in the
+        // same units run_lockin_spin already commands in.
+        if (lockin_config.vel_pi_enable) {
+            float measured_vel_elec = encoder_.vel_estimate_.any().value_or(0.0f)
+                                       * 2.0f * M_PI * motor_.config_.pole_pairs;
+            float error = lockin_config.vel - measured_vel_elec;
+            vel_pi_integrator = std::clamp(vel_pi_integrator + error * vel_pi_dt,
+                                           -lockin_config.vel_pi_limit, lockin_config.vel_pi_limit);
+            float correction = std::clamp(lockin_config.vel_pi_kp * error + lockin_config.vel_pi_ki * vel_pi_integrator,
+                                           -lockin_config.vel_pi_limit, lockin_config.vel_pi_limit);
+            commanded_vel = lockin_config.vel + correction;
+        } else {
+            vel_pi_integrator = 0.0f;  // keep clean if toggled on later mid-spin
+        }
+
+        open_loop_controller_.target_vel_ = commanded_vel;
+        open_loop_controller_.target_current_ = (motor_.config_.motor_type != Motor::MOTOR_TYPE_GIMBAL) ? lockin_config.current : 0.0f;
+        open_loop_controller_.max_phase_vel_ramp_ = lockin_config.accel;
+
         bool reached_target_vel = std::abs(open_loop_controller_.phase_vel_.any().value_or(0.0f) - lockin_config.vel) <= std::numeric_limits<float>::epsilon();
         bool reached_target_dist = open_loop_controller_.total_distance_.any().value_or(0.0f) * dir >= lockin_config.finish_distance * dir;
 
diff --git a/Firmware/MotorControl/axis.hpp b/Firmware/MotorControl/axis.hpp
index 1bfd58d..8f57591 100644
--- a/Firmware/MotorControl/axis.hpp
