@@ -29,6 +29,21 @@ public:
         bool finish_on_vel = false;
         bool finish_on_distance = false;
         bool finish_on_enc_idx = false;
+        // PATCH (velocity PI for reactive open-loop LOCKIN_SPIN): when
+        // vel_pi_enable is false (default), behavior is byte-for-byte the
+        // existing pure open-loop drive (target_vel_ = vel, unchanged). When
+        // true, `vel` is treated as the setpoint and a PI loop -- fed by the
+        // encoder's own vel_estimate_ (works as a plain tachometer here; see
+        // run_lockin_spin()) -- trims the actual commanded field speed to
+        // correct for slip/friction/load. This is the single toggle: flip
+        // vel_pi_enable to switch this axis between pure open-loop and
+        // PI-corrected open-loop. Only meaningful for general_lockin (the
+        // other LockinConfig_t users -- calibration_lockin, sensorless_ramp --
+        // leave it false and are unaffected).
+        bool vel_pi_enable = false;
+        float vel_pi_kp = 0.0f;          // [(rad/s elec) / (rad/s elec)]
+        float vel_pi_ki = 0.0f;          // [(rad/s elec) / (rad/s elec * s)]
+        float vel_pi_limit = 200.0f;     // [rad/s elec] max correction magnitude (anti-windup clamp)
     };
 
