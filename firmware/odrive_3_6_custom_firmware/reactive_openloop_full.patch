 void CANSimple::set_input_vel_callback(Axis& axis, const can_Message_t& msg) {
-    axis.controller_.input_vel_ = can_getSignal<float>(msg, 0, 32, true);
+    float input_vel = can_getSignal<float>(msg, 0, 32, true);
+    axis.controller_.input_vel_ = input_vel;
     axis.controller_.input_torque_ = can_getSignal<float>(msg, 32, 32, true);
+
+    // PATCH (CAN velocity passthrough for reactive open-loop LOCKIN_SPIN):
+    // controller_.input_vel_ above is only ever consumed by the closed-loop
+    // controller task, which does not run while this axis is in LOCKIN_SPIN
+    // (forced-commutation open loop, used when there is no commutation-grade
+    // encoder). Without this, a SET_INPUT_VEL sent to this axis would be
+    // silently absorbed and do nothing. Redirect the same command into
+    // general_lockin.vel instead, which the reactive-open-loop patch in
+    // Axis::run_lockin_spin() already re-reads live every control iteration --
+    // so this axis can be commanded with the exact same CAN message every
+    // other (closed-loop) axis receives.
+    // input_vel_ is in encoder/motor-shaft turns/s (standard ODrive convention,
+    // matching what the host already sends to closed-loop axes via gear_ratio);
+    // general_lockin.vel is electrical rad/s, hence *2*pi*pole_pairs.
+    if (axis.current_state_ == Axis::AXIS_STATE_LOCKIN_SPIN) {
+        axis.config_.general_lockin.vel = input_vel * 2.0f * M_PI * axis.motor_.config_.pole_pairs;
+    }
 }
 
